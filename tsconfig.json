{
    "compilerOptions": {
      "target": "es2022",
      "module": "esnext",
      "moduleResolution": "bundler",
      "baseUrl": ".",
      "paths": {
        "gw-auth/core": ["./src/core/index.ts"]
      },
      "esModuleInterop": true,
      "outDir": "dist/esm",
      "declaration": true,
      "jsx": "react-jsx",
      "strict": true,
      "skipLibCheck": true,
      "verbatimModuleSyntax": true,
    },
    "include": ["src", "test/*.type-test.ts"]
  }
