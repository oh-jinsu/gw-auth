{
  "name": "gw-auth",
  "version": "0.6.0",
  "description": "Framework-neutral TypeScript authentication core with explicit Next.js adapters.",
  "author": "Jinsu Oh",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs/server/index.d.ts",
      "import": "./dist/nextjs/server/index.mjs",
      "require": "./dist/nextjs/server/index.js"
    },
    "./nextjs/client": {
      "types": "./dist/nextjs/client/index.d.ts",
      "import": "./dist/nextjs/client/index.mjs",
      "require": "./dist/nextjs/client/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oh-jinsu/gw-auth.git"
  },
  "license": "MIT",
  "keywords": [
    "authentication",
    "typescript",
    "jwt",
    "oauth",
    "nextjs",
    "refresh-token"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/oh-jinsu/gw-auth/issues"
  },
  "homepage": "https://github.com/oh-jinsu/gw-auth#readme",
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.18",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=15 <17",
    "react": ">=18.2 <20"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "gw-result": "^0.3.0",
    "jose": "^6.2.2"
  }
}
