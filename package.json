  "bugs": {
    "url": "https://github.com/dndnsoft/gw-auth/issues"
  },
  "homepage": "https://github.com/dndnsoft/gw-auth#readme",
  "description": "",
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie": "^1.1.1",
    "gw-file": "^0.1.1",
    "gw-response": "^0.1.7",
    "gw-result": "^0.1.7",
    "jose": "^6.2.2",
    "nodemailer": "^8.0.4",
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
